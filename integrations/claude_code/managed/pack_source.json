{
  "_comment": [
    "Source of the managed policy pack. Edit this file, then run build_pack.py to regenerate the per-platform artifacts, then check_pack.py.",
    "Every value containing REPLACE_ME is a placeholder; check_pack.py reports the pack NOT READY while any remains.",
    "Timeouts in client and hook_timeouts are PROVISIONAL values (owner decision pending); the hook client refuses to run without its configuration file.",
    "The enforcing hooks are generated into the managed settings `hooks` key from hook_timeouts and platform_hook (an admin-installed interpreter and an admin-owned copy of client/hook_client.py). The plugin carries the advisory skill only.",
    "The client reads one configuration file, written by build_pack.py as <platform>/aigov-client.json from `client` and `platform_client`; IT installs it next to platform_hook.client in the admin-owned install directory. Nothing security-relevant goes in `env` (review C1).",
    "env carries git configuration for the agent's own git (GIT_CONFIG_COUNT/KEY_n/VALUE_n, review H2): an admin-owned empty hooks directory (per platform), safe.bareRepository=explicit, push.recurseSubmodules=no, protocol.ext.allow=never."
  ],
  "policy": {
    "forceLoginMethod": "claudeai",
    "forceLoginOrgUUID": [
      "REPLACE_ME_ORG_UUID"
    ],
    "allowedProviders": [
      "anthropic"
    ],
    "requiredMinimumVersion": "2.1.316",
    "allowManagedHooksOnly": true,
    "disableCommandPluginSources": true,
    "allowManagedPermissionRulesOnly": true,
    "disableSideloadFlags": true,
    "strictKnownMarketplaces": [
      {
        "source": "git",
        "url": "https://REPLACE_ME_MARKETPLACE_GIT_URL"
      }
    ],
    "extraKnownMarketplaces": {
      "corp-ai-governance": {
        "source": {
          "source": "git",
          "url": "https://REPLACE_ME_MARKETPLACE_GIT_URL"
        },
        "autoUpdate": true
      }
    },
    "enabledPlugins": {
      "ai-governance@corp-ai-governance": true
    },
    "permissions": {
      "disableBypassPermissionsMode": "disable",
      "deny": [
        "Read(~/.ssh/**)",
        "Read(~/.aws/credentials)",
        "Read(~/.azure/**)",
        "Read(~/.config/gcloud/**)",
        "Read(~/.kube/config)",
        "Read(~/.docker/config.json)",
        "Read(~/.netrc)",
        "Read(~/.git-credentials)",
        "Read(~/.npmrc)",
        "Read(~/.pypirc)",
        "Read(~/.gnupg/**)",
        "Read(//**/.env)",
        "Read(//**/.env.*)",
        "Read(//**/*.pem)",
        "Read(//**/*.key)",
        "Read(//**/id_rsa*)",
        "Read(//**/id_ed25519*)",
        "Edit(~/.claude/settings.json)",
        "Edit(~/.claude/plugins/**)"
      ]
    },
    "env": {
      "CLAUDE_CODE_SYNC_PLUGIN_INSTALL": "1",
      "GIT_CONFIG_COUNT": "4",
      "GIT_CONFIG_KEY_0": "core.hooksPath",
      "GIT_CONFIG_KEY_1": "safe.bareRepository",
      "GIT_CONFIG_VALUE_1": "explicit",
      "GIT_CONFIG_KEY_2": "push.recurseSubmodules",
      "GIT_CONFIG_VALUE_2": "no",
      "GIT_CONFIG_KEY_3": "protocol.ext.allow",
      "GIT_CONFIG_VALUE_3": "never"
    },
    "companyAnnouncements": [
      "AI activity in Claude Code on this machine is checked and recorded by the company AI-governance service. Refused actions show a decision id; quote it when you contact the security team."
    ]
  },
  "hook_timeouts": {
    "decide": 15,
    "report": 5,
    "SessionEnd": 2
  },
  "client": {
    "service_url": "https://REPLACE_ME_SERVICE_HOST",
    "decide_timeout_seconds": 8,
    "report_timeout_seconds": 1,
    "hook_deadline_seconds": 14,
    "surface": "cli"
  },
  "platform_client": {
    "windows": {
      "ca_bundle": "C:\\Program Files\\AIGovernance\\ca-bundle.pem",
      "token_file": "C:\\ProgramData\\AIGovernance\\device-token",
      "git_path": "C:\\Program Files\\Git\\cmd\\git.exe",
      "log_file": "C:\\ProgramData\\AIGovernance\\logs\\hook-client.log"
    },
    "macos": {
      "ca_bundle": "/Library/Application Support/AIGovernance/ca-bundle.pem",
      "token_file": "/Library/Application Support/AIGovernance/device-token",
      "git_path": "/usr/bin/git",
      "log_file": "/Library/Logs/AIGovernance/hook-client.log"
    },
    "linux": {
      "ca_bundle": "/etc/ai-governance/ca-bundle.pem",
      "token_file": "/etc/ai-governance/device-token",
      "git_path": "/usr/bin/git",
      "log_file": "/var/log/ai-governance/hook-client.log"
    }
  },
  "platform_env": {
    "windows": {
      "GIT_CONFIG_VALUE_0": "C:\\Program Files\\AIGovernance\\git-hooks"
    },
    "macos": {
      "GIT_CONFIG_VALUE_0": "/Library/Application Support/AIGovernance/git-hooks"
    },
    "linux": {
      "GIT_CONFIG_VALUE_0": "/usr/local/lib/ai-governance/git-hooks"
    }
  },
  "platform_deny": {
    "windows": [
      "Read(//c/ProgramData/AIGovernance/**)",
      "Edit(//c/ProgramData/AIGovernance/**)",
      "Edit(//c/Program Files/AIGovernance/**)"
    ],
    "macos": [
      "Read(//Library/Application Support/AIGovernance/**)",
      "Edit(//Library/Application Support/AIGovernance/**)"
    ],
    "linux": [
      "Read(//etc/ai-governance/**)",
      "Edit(//etc/ai-governance/**)",
      "Edit(//usr/local/lib/ai-governance/**)"
    ]
  },
  "platform_hook": {
    "windows": {
      "command": "C:\\Program Files\\AIGovernance\\python\\python.exe",
      "client": "C:\\Program Files\\AIGovernance\\hook_client.py"
    },
    "macos": {
      "command": "/Library/Application Support/AIGovernance/python/bin/python3",
      "client": "/Library/Application Support/AIGovernance/hook_client.py"
    },
    "linux": {
      "command": "/usr/bin/python3",
      "client": "/usr/local/lib/ai-governance/hook_client.py"
    }
  }
}
