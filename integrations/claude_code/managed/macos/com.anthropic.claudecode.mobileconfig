	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDisplayName</key>
			<string>Claude Code managed settings</string>
			<key>PayloadIdentifier</key>
			<string>com.corp.aigovernance.claudecode.settings</string>
			<key>PayloadType</key>
			<string>com.anthropic.claudecode</string>
			<key>PayloadUUID</key>
			<string>F9764E3A-D2F6-5499-9B57-5F12140612D4</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>allowManagedHooksOnly</key>
			<true/>
			<key>allowManagedPermissionRulesOnly</key>
			<true/>
			<key>allowedProviders</key>
			<array>
				<string>anthropic</string>
			</array>
			<key>companyAnnouncements</key>
			<array>
				<string>AI activity in Claude Code on this machine is checked and recorded by the company AI-governance service. Refused actions show a decision id; quote it when you contact the security team.</string>
			</array>
			<key>disableCommandPluginSources</key>
			<true/>
			<key>disableSideloadFlags</key>
			<true/>
			<key>enabledPlugins</key>
			<dict>
				<key>ai-governance@corp-ai-governance</key>
				<true/>
			</dict>
			<key>env</key>
			<dict>
				<key>CLAUDE_CODE_SYNC_PLUGIN_INSTALL</key>
				<string>1</string>
				<key>GIT_CONFIG_COUNT</key>
				<string>4</string>
				<key>GIT_CONFIG_KEY_0</key>
				<string>core.hooksPath</string>
				<key>GIT_CONFIG_KEY_1</key>
				<string>safe.bareRepository</string>
				<key>GIT_CONFIG_KEY_2</key>
				<string>push.recurseSubmodules</string>
				<key>GIT_CONFIG_KEY_3</key>
				<string>protocol.ext.allow</string>
				<key>GIT_CONFIG_VALUE_0</key>
				<string>/Library/Application Support/AIGovernance/git-hooks</string>
				<key>GIT_CONFIG_VALUE_1</key>
				<string>explicit</string>
				<key>GIT_CONFIG_VALUE_2</key>
				<string>no</string>
				<key>GIT_CONFIG_VALUE_3</key>
				<string>never</string>
			</dict>
			<key>extraKnownMarketplaces</key>
			<dict>
				<key>corp-ai-governance</key>
				<dict>
					<key>autoUpdate</key>
					<true/>
					<key>source</key>
					<dict>
						<key>source</key>
						<string>git</string>
						<key>url</key>
						<string>https://REPLACE_ME_MARKETPLACE_GIT_URL</string>
					</dict>
				</dict>
			</dict>
			<key>forceLoginMethod</key>
			<string>claudeai</string>
			<key>forceLoginOrgUUID</key>
			<array>
				<string>REPLACE_ME_ORG_UUID</string>
			</array>
			<key>hooks</key>
			<dict>
				<key>PostToolUse</key>
				<array>
					<dict>
						<key>hooks</key>
						<array>
							<dict>
								<key>args</key>
								<array>
									<string>-I</string>
									<string>/Library/Application Support/AIGovernance/hook_client.py</string>
									<string>report</string>
								</array>
								<key>command</key>
								<string>/Library/Application Support/AIGovernance/python/bin/python3</string>
								<key>timeout</key>
								<integer>5</integer>
								<key>type</key>
								<string>command</string>
							</dict>
						</array>
						<key>matcher</key>
						<string>*</string>
					</dict>
				</array>
				<key>PreToolUse</key>
				<array>
					<dict>
						<key>hooks</key>
						<array>
							<dict>
								<key>args</key>
								<array>
									<string>-I</string>
									<string>/Library/Application Support/AIGovernance/hook_client.py</string>
