								<key>command</key>
								<string>/Library/Application Support/AIGovernance/python/bin/python3</string>
								<key>onFailure</key>
								<string>block</string>
								<key>timeout</key>
								<integer>15</integer>
								<key>type</key>
								<string>command</string>
							</dict>
						</array>
					</dict>
				</array>
				<key>Stop</key>
				<array>
					<dict>
						<key>hooks</key>
						<array>
							<dict>
								<key>args</key>
								<array>
									<string>-I</string>
									<string>/Library/Application Support/AIGovernance/hook_client.py</string>
