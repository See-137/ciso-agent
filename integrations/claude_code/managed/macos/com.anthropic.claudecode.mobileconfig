			<key>permissions</key>
			<dict>
				<key>deny</key>
				<array>
					<string>Read(~/.ssh/**)</string>
					<string>Read(~/.aws/credentials)</string>
					<string>Read(~/.azure/**)</string>
					<string>Read(~/.config/gcloud/**)</string>
					<string>Read(~/.kube/config)</string>
					<string>Read(~/.docker/config.json)</string>
					<string>Read(~/.netrc)</string>
					<string>Read(~/.git-credentials)</string>
