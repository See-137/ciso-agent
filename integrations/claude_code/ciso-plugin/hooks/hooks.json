{
  "description": "CISO agent: every tool call and every prompt is decided locally, before it runs, by the bundled governance engine and ruleset. Exec form (no shell). uv runs isolated with every package source fixed on the command line (environment and nearby configuration cannot choose the interpreter environment or the index). onFailure block: a crash, a missing runtime or a timeout blocks the action.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--isolated",
              "--no-config",
              "--no-project",
              "--no-env-file",
              "--python",
              ">=3.13",
              "--default-index",
              "https://pypi.org/simple",
              "--index",
              "https://pypi.org/simple",
              "--find-links",
              "${CLAUDE_PLUGIN_ROOT}/scripts/no-local-packages",
              "--index-strategy",
              "first-index",
              "--keyring-provider",
              "disabled",
              "--no-build",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--with-requirements",
              "${CLAUDE_PLUGIN_ROOT}/scripts/runtime-requirements.txt",
              "--",
              "python",
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/ciso_hook.py"
            ],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--isolated",
              "--no-config",
              "--no-project",
              "--no-env-file",
              "--python",
              ">=3.13",
              "--default-index",
              "https://pypi.org/simple",
              "--index",
              "https://pypi.org/simple",
              "--find-links",
              "${CLAUDE_PLUGIN_ROOT}/scripts/no-local-packages",
              "--index-strategy",
              "first-index",
              "--keyring-provider",
              "disabled",
              "--no-build",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--with-requirements",
              "${CLAUDE_PLUGIN_ROOT}/scripts/runtime-requirements.txt",
              "--",
              "python",
              "-I",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/ciso_hook.py"
            ],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
